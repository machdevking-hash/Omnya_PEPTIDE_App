# Copy to .env and fill in. .env is gitignored; this file is the committed template.
#
# Build with every value passed to the app:
#   flutter build ios --release --dart-define-from-file=.env
# Only REVENUECAT_APPLE_API_KEY and SUPABASE_* are read by the app. The rest is reference.

# --- App (read at build time via --dart-define) ---
# RevenueCat public SDK key (starts with appl_)
REVENUECAT_APPLE_API_KEY=

# Supabase (use prod for release builds). Both values are public, publishable ones.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Apple (reference only) ---
APPLE_TEAM_ID=
BUNDLE_ID=com.omnya.omnya
APP_GROUP=group.com.omnya.omnya

# App Store Connect API team key used for signing and upload.
# The .p8 file lives in ~/.private_keys, never in the repo.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.private_keys/AuthKey_<KEY_ID>.p8

# RevenueCat in-app purchase key id (file: SubscriptionKey_<KEY_ID>.p8)
RC_IAP_KEY_ID=

# Store products and RevenueCat entitlement
IAP_MONTHLY=omnya_pro_monthly
IAP_YEARLY=omnya_pro_yearly
IAP_LIFETIME=omnya_pro_lifetime
RC_ENTITLEMENT=omnya_pro
